      "workflowId": "workflow-node-1771009705229-ez9ge1zj7",
      "workflowName": "Workflow 1",
      "prdSections": [
        {
          "id": "overview",
          "title": "Overview",
          "content": "Workflow 1 is designed to guide users through selecting, starting, and completing workout routines. It includes processes for routine selection, workout navigation, and completion tracking."
        },
        {
          "id": "requirements",
          "title": "Requirements",
          "content": "The system must allow users to log in, select routines, save workouts, and navigate through exercises. It should track progress and provide completion metrics."
        },
        {
          "id": "user-flow",
          "title": "User Flow",
          "content": "Users log in to access workout routines. They can select a routine to view details, save it, edit it, or start it. Once started, users navigate through exercises, with options to pause, skip, or mark all as completed. Upon completion, users see a dashboard with routine metrics."
        },
        {
          "id": "inputs-outputs",
          "title": "Inputs & Outputs",
          "content": "Inputs include user actions such as selecting, saving, editing, and starting routines. Outputs are completed workout notifications and routine metrics displayed on the user dashboard."
        },
        {
          "id": "failure-scenarios",
          "title": "Failure Scenarios",
          "content": "Failures may occur if a user cannot save a routine, if the workout screen fails to load, or if navigation between exercises is interrupted. Errors in marking exercises as completed or pausing routines could also occur."
        },
        {
          "id": "recovery-fallback",
          "title": "Recovery & Fallback Paths",
          "content": "The system should retry saving operations and provide error messages if failures persist. Navigation errors should redirect users to the last successful state. A fallback to the routine details screen is necessary if the workout screen fails."
        },
        {
          "id": "operational-risks",
          "title": "Operational Risks",
          "content": "Risks include server downtime affecting login and routine access, data loss during save operations, and UI glitches during exercise navigation. Monitoring for server health and user activity logs is essential."
        },
        {
          "id": "acceptance-criteria",
          "title": "Acceptance Criteria",
          "content": "The workflow should allow seamless login, routine selection, and exercise navigation. Users must be able to save, edit, and start routines without errors. Completion metrics should be accurately displayed on the dashboard."
        }
      ],
